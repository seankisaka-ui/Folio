# Generate a strong secret with: npx auth@latest secret
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=./data/folio.db

# Optional: hostnames used to open the dev server from another local browser runtime.
ALLOWED_DEV_ORIGINS=

# Optional. The core product works without AI; the assistant is disabled unless set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
